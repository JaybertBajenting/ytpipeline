# NOTE: '#' only starts a comment at the beginning of a line. An inline "pattern # comment"
# is treated as one literal pattern and silently matches nothing — so every comment here
# gets its own line.

# Build output
bin/
obj/
web/node_modules/
web/dist/
*.tsbuildinfo

# Published double-clickable app (regenerate with publish-app.cmd)
app/

# Generated by the Vite build (npm --prefix web run build)
src/YtPipeline.Web/wwwroot/

# Secrets — never commit
.env
.env.*
!.env.example
client_secret.json
.youtube-tokens/

# Publishing credentials entered in Settings → Publishing
secrets.json

# Transient operational state: which providers are quota-benched right now
provider-health.json

# Per-run working files (regenerated): videos/<channel>/<timestamp>/
videos/
logs/

# Reference material downloaded for format study (third-party audio and transcripts).
# Local analysis only — must never be redistributed via the repo.
_research/

# Same rule for the source channel's own frames and thumbnails that a channel's referenceStudy
# attaches to image generation (channels/<id>.references/). The channel json points at them, so
# a fresh clone has to restore this folder before that channel can generate.
channels/*.references/

# IDE
.vs/
.idea/
*.user

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
